function! s:StartupLayout()
  " Open NERDTree on the left
  NERDTree

  " Move focus to the main editing window (right of NERDTree)
  wincmd l

  " Open a terminal split spanning the full width, at the bottom
  if has('terminal')
    botright terminal
	" Resize to 1/3 of the total window height
    execute 'resize ' . (&lines / 3)
  endif

  " Return focus to the editing window, not the terminal
  wincmd k
endfunction

autocmd VimEnter * call s:StartupLayout()


" --- Toggle Terminal like VS Code (Ctrl + `) ---
function! ToggleTerminal() abort
  " 1. Search for an existing terminal buffer
  let l:term_buf = -1
  for l:buf in filter(range(1, bufnr('$')), 'bufexists(v:val)')
    if getbufvar(l:buf, '&buftype') ==# 'terminal'
      let l:term_buf = l:buf
      break
    endif
  endfor

  " 2. Check if that terminal buffer is currently visible in any window
  let l:term_win = (l:term_buf != -1) ? bufwinnr(l:term_buf) : -1

  if l:term_win != -1
    " Terminal is visible
    if winnr() == l:term_win
      " If we are currently inside the terminal window, hide it
      hide
    else
      " If we are in another window (e.g. editor), jump into the terminal
      execute l:term_win . 'wincmd w'
      startinsert
    endif
  else
    " Terminal is hidden or doesn't exist yet
    if l:term_buf != -1
      " Re-open existing terminal at bottom
      execute 'botright sbuffer ' . l:term_buf
    else
      " Create a new terminal buffer at bottom
      botright terminal
    endif
    " Resize terminal height to ~1/3 of the total screen
    execute 'resize ' . (&lines / 3)
  endif
endfunction

" Map Ctrl + ` in Normal, Insert, and Terminal mode
nnoremap <silent> <C-`> :call ToggleTerminal()<CR>
inoremap <silent> <C-`> <Esc>:call ToggleTerminal()<CR>
tnoremap <silent> <C-`> <C-\><C-n>:call ToggleTerminal()<CR>


" --- Toggle Zoom (Fullscreen Code Area) ---
function! ToggleZoom() abort
  if tabpagenr('$') > 1
    " If more than one tab is open, close the zoomed tab and return to multi-pane layout
    tabclose
  else
    " Open current file buffer in a new tab (hides NERDTree & Terminal splits)
    tabnew %
  endif
endfunction

" map F11 mapping
nnoremap <silent> <F11> :call ToggleZoom()<CR>


