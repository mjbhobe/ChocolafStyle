" from ChatGPT - format C/C++ files safely with clang-format on save
" Safely run clang-format before saving. Abort if it fails.
autocmd BufWritePre *.c,*.cpp,*.h,*.hpp call s:ClangFormatSafe()

function! s:ClangFormatSafe() abort
  if executable('clang-format')
    " Get full buffer text and send to clang-format
    let l:formatted = system('clang-format --style=file', join(getline(1,'$'), "\n"))
    if v:shell_error != 0
      echohl ErrorMsg
      echom "clang-format failed! Save aborted."
      echohl None
      " Abort writing file
      throw 'clang-format failed'
    else
      " Replace buffer with formatted text if OK
      let l:view = winsaveview()
      silent! %delete _
      call setline(1, split(l:formatted, "\n"))
      call winrestview(l:view)
    endif
  endif
endfunction


" from ChatGPT - format Python files safely with ruff on save
" Safely run ruff before saving. Abort if it fails.
autocmd BufWritePre *.py call s:RuffFormatSafe()


function! s:RuffFormatSafe() abort
    if executable('ruff')
        " Get the full buffer text as a single string, joined by newlines.
        let l:buffer_content = join(getline(1,'$'), "\n")

        " Execute ruff format.
        " '--stdin-filename' is used to tell ruff the file type/name,
        " enabling it to respect per-file configuration in pyproject.toml.
        let l:formatted = system('ruff format --stdin-filename '.shellescape(expand('%:p')), l:buffer_content)

        " Check the exit status of the external command.
        if v:shell_error != 0
            echohl ErrorMsg
            echom "Ruff formatting failed! Save aborted. (Check ruff output for details)"
            echohl None

            " Abort the save operation immediately.
            throw 'Ruff formatting failed'
        else
            " --- SUCCESS ---
            " 1. Preserve cursor position and view state.
            let l:view = winsaveview()

            " 2. Clear the current buffer silently.
            silent! %delete _

            " 3. Replace buffer content with the formatted text.
            " We need to split the output back into lines.
            call setline(1, split(l:formatted, "\n"))

            " 4. Restore cursor position and view state.
            call winrestview(l:view)
        endif
    endif
endfunction


